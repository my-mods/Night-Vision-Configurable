[Settings]
enabled = 1
; 0 = Radius, 1 = Fullscreen, 2 = Natural (default)
nightVisionMode = 2
; Radius only: 5 to 50 metres, in 1-metre steps
radiusMeters = 6
; Natural only: outer oval size, 40 to 100%, in 5% steps
naturalFocusSize = 90
; Natural only: fraction of the radius used for falloff, 20 to 100%, in 5% steps
naturalSoftness = 70
vignette = 1
vignetteOpacity = 20
monochrome = 0
; Preserve red shades with Black & White. Other red objects also stay coloured.
keepBloodRed = 0
; Keep blood red only: 100% = normal, up to 500%, in 10% steps
redBrightnessPercent = 100
; Red tint colours the light in Radius mode, the view in Fullscreen; unused in Natural
redMonochrome = 0
; 25 to 300%, in 5% steps. 100% = normal Fullscreen/Natural view / standard radius light
brightnessPercent = 200
controllerInput = 1
debugLogging = 0
