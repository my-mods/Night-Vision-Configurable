[Settings]
enabled = 1
; Menu order: 1 = Fullscreen (default), 2 = Natural, 0 = Radius
nightVisionMode = 1
; Radius only: 5 to 50 metres, in 1-metre steps
radiusMeters = 6
; Natural only: outer oval size, 40 to 100%, in 5% steps
naturalFocusSize = 90
; Natural only: fraction of the radius used for falloff, 20 to 100%, in 5% steps
naturalSoftness = 70
vignette = 1
vignetteOpacity = 20
monochrome = 0
; Preserve red shades with Black & White. Other red objects also stay coloured.
keepBloodRed = 0
; Keep blood red only: 100% = normal, up to 500%, in 10% steps
redBrightnessPercent = 100
; Red tint colours nearby scenery in Radius, the view in Fullscreen; unused in Natural
redMonochrome = 0
; 25 to 300%, in 5% steps. Multiply: 100% is neutral. Absolute: 100% is 0 EV.
brightnessPercent = 200
; Fullscreen only: 0 = Multiply (default), 1 = Absolute exposure (-2 to +4 EV)
brightnessCalculation = 0
controllerInput = 1
debugLogging = 0
